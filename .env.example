# User Management Service - Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# Database Configuration
# For PostgreSQL (Production):
DATABASE_URL=postgresql://one_call_user:your_secure_password_here@localhost:5432/one_call_users
# For SQLite (Development only):
# DATABASE_URL=sqlite:///./users.db

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8007

# MCP Server Configuration
MCP_HOST=127.0.0.1
MCP_PORT=8008
MCP_TRANSPORT=sse

# JWT Configuration
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=REPLACE_WITH_STRONG_SECRET_64_BYTES_MINIMUM
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password Configuration
BCRYPT_ROUNDS=12
MIN_PASSWORD_LENGTH=8

# Redis Configuration (for token blacklist)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# General Configuration
TIMEZONE=UTC
MAX_USERS=10000

# SECURITY: Remove default admin credentials from environment
# Use create_admin.py script to create admin users securely
# DEFAULT_ADMIN_MOBILE=
# DEFAULT_ADMIN_PASSWORD=
